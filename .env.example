# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-output-from-openssl

# Public HTTPS origin used as the OAuth issuer; real deployments put a TLS terminator in front.
# For local verification, use https://localhost:18080 as the issuer and curl http://localhost:18080.
PUBLIC_URL=https://taskory.example

# Host interface and port published by the web service. Keep loopback when using a TLS proxy.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Count trusted proxies, including nginx: 1 without an outer proxy, 2 with one.
TRUST_PROXY_HOPS=1

# The API always uses this internal URL; keep it when enabling the ollama profile.
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama3.2
DEEPSEEK_API_KEY=
