# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-output-from-openssl

# MySQL 8.4. Set strong unique passwords; MySQL enforces MEDIUM password policy.
MYSQL_ROOT_PASSWORD=replace-with-a-Strong-password-42
DB_HOST=mysql
DB_PORT=3306
DB_NAME=taskory
DB_USER=taskory
DB_PASSWORD=replace-with-another-Strong-password-73

# Public HTTPS origin used as the OAuth issuer; real deployments put a TLS terminator in front.
# For local verification, use https://localhost:18080 as the issuer and curl http://localhost:18080.
PUBLIC_URL=https://taskory.example

# Host interface and port published by the web service. Keep loopback when using a TLS proxy.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Count trusted proxies, including nginx: 1 without an outer proxy, 2 with one.
TRUST_PROXY_HOPS=1

# The API always uses this internal URL; keep it when enabling the ollama profile.
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_LLM_PROVIDER=ollama
# These report settings apply to every user's reports. DEFAULT_LLM_MODEL is an optional override.
# The provider default is llama3.2 for Ollama and deepseek-flash for DeepSeek.
# Optional server-wide prices in USD per 1M prompt/completion tokens.
# If unset: Ollama is $0; DeepSeek defaults to $0.30 input / $1.20 output.
# These are upper-bound estimates; they ignore cache-hit and off-peak discounts.
# LLM_PRICE_INPUT_PER_MTOK=0.30
# LLM_PRICE_OUTPUT_PER_MTOK=1.20
DEEPSEEK_API_KEY=
