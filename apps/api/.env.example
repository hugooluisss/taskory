# Production issuer: HTTPS origin only, with no path, query, or fragment.
# Local HTTP is allowed only for localhost, 127.0.0.1, or [::1].
PUBLIC_URL=https://taskory.example
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=taskory.sqlite
# Set DB_SYNCHRONIZE=true to enable TypeORM schema synchronization in production.
# Set DB_SYNCHRONIZE=false to disable it outside production.
DB_SYNCHRONIZE=
# Auth endpoints default to 10 requests per 60000 milliseconds.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_MS=60000
# Number of trusted proxies after the client; direct API access defaults to 0.
TRUST_PROXY_HOPS=0
OAUTH_RATE_LIMIT=10
OAUTH_RATE_WINDOW_MS=60000
# Unauthenticated authorize requests default to five times OAUTH_RATE_LIMIT.
OAUTH_AUTHORIZE_RATE_LIMIT=
OLLAMA_BASE_URL=http://localhost:11434
DEEPSEEK_API_KEY=
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama3.2
LLM_TIMEOUT_MS=180000
REPORT_CHUNK_SIZE=100

# Auth rate limit (per IP). Raise it when running the Bruno collection repeatedly.
# AUTH_RATE_LIMIT=10
# AUTH_RATE_WINDOW_MS=60000
