meta {
  name: Reject invalid report language
  type: http
  seq: 4
}
post {
  url: {{baseUrl}}/reports
  body: json
  auth: bearer
}
auth:bearer {
  token: {{reportsToken}}
}
headers {
  Content-Type: application/json
  Accept: application/json
  Accept-Language: en
}
body:json {
  {
    "from": "2026-11-16",
    "to": "2026-11-16",
    "language": "fr"
  }
}
script:pre-request {
  const user = await bru.sendRequest({
    method: "POST",
    url: bru.getEnvVar("baseUrl") + "/auth/register",
    headers: { "Content-Type": "application/json" },
    data: { email: "reports-language+" + Date.now() + "@example.com", name: "Reports invalid language", password: bru.getEnvVar("password") }
  });
  bru.setVar("reportsToken", user.data.token);
}
docs {
  Spec scenario: report-generation / Report language and style / Requested language. Expects 400 VALIDATION_ERROR for language fr.
}
tests {
  test("rejects an unsupported report language", function() {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("VALIDATION_ERROR");
  });
}
