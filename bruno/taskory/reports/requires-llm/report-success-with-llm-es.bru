meta {
  name: Successful report with LLM (Spanish)
  type: http
  seq: 2
  tags: [
    requires-llm
  ]
}
post {
  url: {{baseUrl}}/reports
  body: json
  auth: bearer
}
auth:bearer {
  token: {{reportsToken}}
}
headers {
  Content-Type: application/json
  Accept: application/json
  Accept-Language: es
}
body:json {
  {
    "from": "2026-11-16",
    "to": "2026-11-16",
    "language": "es"
  }
}
script:pre-request {
  const user = await bru.sendRequest({
    method: "POST",
    url: bru.getEnvVar("baseUrl") + "/auth/register",
    headers: { "Content-Type": "application/json" },
    data: { email: "reports-success-es+" + Date.now() + "@example.com", name: "Reports success Spanish", password: bru.getEnvVar("password") }
  });
  bru.setVar("reportsToken", user.data.token);
  await bru.sendRequest({
    method: "POST",
    url: bru.getEnvVar("baseUrl") + "/activities",
    headers: { "Content-Type": "application/json", Authorization: "Bearer " + user.data.token },
    data: { date: "2026-11-16", title: "Report activity for Spanish success" }
  });
}
docs {
  Spec scenario: report-generation / Report generation / Successful report. Requires a running Ollama provider; tag: requires-llm.
}
tests {
  test("generates a Spanish Markdown report", function() {
    expect(res.status).to.equal(200);
    expect(res.body.markdown).to.be.a("string").and.not.empty;
    expect(res.body.provider).to.equal("ollama");
    expect(res.body.model).to.be.a("string").and.not.empty;
    expect(res.body.totalTokens).to.be.a("number");
    expect(res.body.promptTokens).to.be.a("number");
    expect(res.body.completionTokens).to.be.a("number");
    expect(res.body.costUsd).to.be.a("number");
    expect(res.body.activityCount).to.equal(1);
  });
}
