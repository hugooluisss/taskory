meta {
  name: Foreign user cannot retry chunked report
  type: http
  seq: 8
  tags: [
    requires-fake-ollama
    chunked
  ]
}
post {
  url: {{baseUrl}}/reports/{{reportId}}/retry
  body: none
  auth: bearer
}
auth:bearer {
  token: {{reportsToken}}
}
headers {
  Accept: application/json
}
script:pre-request {
  const baseUrl = bru.getEnvVar("baseUrl");
  const password = bru.getEnvVar("password");
  const owner = await bru.sendRequest({ method: "POST", url: baseUrl + "/auth/register", headers: { "Content-Type": "application/json" }, data: { email: "chunked-retry-owner+" + Date.now() + "@example.com", name: "Chunked retry owner", password } });
  const foreign = await bru.sendRequest({ method: "POST", url: baseUrl + "/auth/register", headers: { "Content-Type": "application/json" }, data: { email: "chunked-retry-foreign+" + Date.now() + "@example.com", name: "Chunked retry foreign", password } });
  bru.setVar("reportsToken", foreign.data.token);
  for (let i = 0; i < 101; i++) await bru.sendRequest({ method: "POST", url: baseUrl + "/activities", headers: { "Content-Type": "application/json", Authorization: "Bearer " + owner.data.token }, data: { date: "2026-11-16", title: "Owner activity " + i } });
  const job = await bru.sendRequest({ method: "POST", url: baseUrl + "/reports", headers: { "Content-Type": "application/json", Authorization: "Bearer " + owner.data.token }, data: { from: "2026-11-16", to: "2026-11-16", language: "en" } });
  bru.setVar("reportId", job.data.id);
}
docs {
  Spec scenario: chunked-report-generation / Report job status / Foreign job. Retry route returns 404 for a foreign owner; requires fake Ollama.
}
tests {
  test("hides retry for a report owned by another user", function() {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal("NOT_FOUND");
  });
}
