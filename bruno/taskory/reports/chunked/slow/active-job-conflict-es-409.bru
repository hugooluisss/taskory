meta {
  name: Second active chunked job returns Spanish message
  type: http
  seq: 2
  tags: [
    requires-fake-ollama
    chunked
  ]
}
post {
  url: {{baseUrl}}/reports
  body: json
  auth: bearer
}
auth:bearer {
  token: {{reportsToken}}
}
headers {
  Content-Type: application/json
  Accept: application/json
  Accept-Language: es
}
body:json {
  {
    "from": "2026-11-16",
    "to": "2026-11-16",
    "language": "es"
  }
}
script:pre-request {
  const baseUrl = bru.getEnvVar("baseUrl");
  const user = await bru.sendRequest({ method: "POST", url: baseUrl + "/auth/register", headers: { "Content-Type": "application/json" }, data: { email: "chunked-active-es+" + Date.now() + "@example.com", name: "Chunked active Spanish", password: bru.getEnvVar("password") } });
  bru.setVar("reportsToken", user.data.token);
  for (let i = 0; i < 101; i++) {
    await bru.sendRequest({ method: "POST", url: baseUrl + "/activities", headers: { "Content-Type": "application/json", Authorization: "Bearer " + user.data.token }, data: { date: "2026-11-16", title: "Actividad activa " + i } });
  }
  const first = await bru.sendRequest({ method: "POST", url: baseUrl + "/reports", headers: { "Content-Type": "application/json", Authorization: "Bearer " + user.data.token }, data: { from: "2026-11-16", to: "2026-11-16", language: "es" } });
  bru.setVar("firstReportId", first.data.id);
}
docs {
  Spec scenario: chunked-report-generation / Concurrency limits / Second job of the same user. Slow fake keeps the first job active during the second POST.
}
tests {
  test("returns the localized Spanish in-progress message", function() {
    expect(res.status).to.equal(409);
    expect(res.body.code).to.equal("REPORT_IN_PROGRESS");
    expect(res.body.id).to.equal(bru.getVar("firstReportId"));
    expect(res.body.message).to.equal("Ya hay un informe en curso");
  });
}
