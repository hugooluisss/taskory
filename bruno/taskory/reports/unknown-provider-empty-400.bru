meta {
  name: Reject unknown provider with no activities
  type: http
  seq: 10
}
post {
  url: {{baseUrl}}/reports
  body: json
  auth: bearer
}
auth:bearer {
  token: {{reportsToken}}
}
headers {
  Content-Type: application/json
  Accept: application/json
  Accept-Language: en
}
body:json {
  {
    "from": "2026-11-16",
    "to": "2026-11-16",
    "language": "en",
    "provider": "nope"
  }
}
script:pre-request {
  const user = await bru.sendRequest({
    method: "POST",
    url: bru.getEnvVar("baseUrl") + "/auth/register",
    headers: { "Content-Type": "application/json" },
    data: { email: "reports-unknown-empty+" + Date.now() + "@example.com", name: "Unknown provider without activities", password: bru.getEnvVar("password") }
  });
  bru.setVar("reportsToken", user.data.token);
}
docs {
  Spec scenario: report-generation / Provider failure handling / Unknown provider. Fresh user has no activities; expects 400 UNKNOWN_PROVIDER before activity lookup.
}
tests {
  test("rejects an unknown provider before checking activities", function() {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("UNKNOWN_PROVIDER");
  });
}
