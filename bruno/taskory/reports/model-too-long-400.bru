meta {
  name: Reject model longer than 100 characters
  type: http
  seq: 11
}
post {
  url: {{baseUrl}}/reports
  body: json
  auth: bearer
}
auth:bearer {
  token: {{reportsToken}}
}
headers {
  Content-Type: application/json
  Accept: application/json
}
body:json {
  {
    "from": "2026-11-16",
    "to": "2026-11-16",
    "language": "en",
    "model": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  }
}
script:pre-request {
  const user = await bru.sendRequest({
    method: "POST",
    url: bru.getEnvVar("baseUrl") + "/auth/register",
    headers: { "Content-Type": "application/json" },
    data: { email: "reports-model-limit+" + Date.now() + "@example.com", name: "Report model limit", password: bru.getEnvVar("password") }
  });
  bru.setVar("reportsToken", user.data.token);
}
docs {
  Spec scenario: report-generation / Input validation. Model is limited to 100 characters.
}
tests {
  test("rejects a model over 100 characters", function() {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("VALIDATION_ERROR");
  });
}
