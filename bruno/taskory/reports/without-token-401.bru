meta {
  name: List providers without token
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/reports
  body: json
  auth: none
}
headers {
  Content-Type: application/json
  Accept: application/json
}
body:json {
  {
    "from": "2026-11-16",
    "to": "2026-11-16",
    "language": "en"
  }
}
script:pre-request {
  await bru.sendRequest({
    method: "POST",
    url: bru.getEnvVar("baseUrl") + "/auth/register",
    headers: { "Content-Type": "application/json" },
    data: { email: "reports-no-token+" + Date.now() + "@example.com", name: "Reports no token", password: bru.getEnvVar("password") }
  });
}
docs {
  Spec scenario: report-generation / Successful report / Authentication required. Expects 401 without a bearer token.
}
tests {
  test("requires authentication", function() {
    expect(res.status).to.equal(401);
  });
}
