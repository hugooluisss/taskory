meta {
  name: List reports
  type: http
  seq: 10
}
get {
  url: {{baseUrl}}/reports?page=1&limit=20
  body: none
  auth: bearer
}
auth:bearer {
  token: {{reportsToken}}
}
headers {
  Accept: application/json
}
script:pre-request {
  const user = await bru.sendRequest({
    method: "POST",
    url: bru.getEnvVar("baseUrl") + "/auth/register",
    headers: { "Content-Type": "application/json" },
    data: { email: "reports-list+" + Date.now() + "@example.com", name: "Report list", password: bru.getEnvVar("password") }
  });
  bru.setVar("reportsToken", user.data.token);
}
docs {
  Lists the caller's report summaries without Markdown.
}
tests {
  test("returns a paginated list without Markdown", function() {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(res.body.page).to.equal(1);
    expect(res.body.limit).to.equal(20);
    expect(res.body.total).to.be.a("number");
    for (const report of res.body.items) expect(report).not.to.have.property("markdown");
  });
}
