meta {
  name: Create project
  type: http
  seq: 1
}
post {
  url: {{baseUrl}}/projects
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
headers {
  Content-Type: application/json
  Accept: application/json
}
body:json {
  {
    "name": "{{newProjectName}}"
  }
}
script:pre-request {
  bru.setVar("newProjectName", "Bruno project " + Date.now());
}
tests {
  test("creates and returns a project", function() {
    expect(res.status).to.equal(201);
    expect(res.body.name).to.equal(bru.getVar("newProjectName"));
    expect(res.body.archived).to.equal(false);
    expect(res.body).to.have.all.keys("id", "name", "archived", "createdAt", "updatedAt");
  });
}
