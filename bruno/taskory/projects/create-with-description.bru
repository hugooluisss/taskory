meta {
  name: Create project with description
  type: http
  seq: 6
}
post {
  url: {{baseUrl}}/projects
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
headers {
  Content-Type: application/json
  Accept: application/json
}
body:json {
  {
    "name": "{{describedProjectName}}",
    "description": "{{projectDescription}}"
  }
}
script:pre-request {
  bru.setVar("describedProjectName", "Bruno described project " + Date.now());
  bru.setVar("projectDescription", "A short project context.");
}
docs {
  Creates a project with an optional trimmed description (maximum 1000 characters).
}
tests {
  test("returns the project description", function() {
    expect(res.status).to.equal(201);
    expect(res.body.name).to.equal(bru.getVar("describedProjectName"));
    expect(res.body.description).to.equal(bru.getVar("projectDescription"));
  });
}
