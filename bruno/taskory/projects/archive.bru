meta {
  name: Archive project
  type: http
  seq: 5
}
patch {
  url: {{baseUrl}}/projects/{{archiveProjectId}}
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
headers {
  Content-Type: application/json
  Accept: application/json
}
body:json {
  {
    "archived": true
  }
}
script:pre-request {
  const project = await bru.sendRequest({ method: "POST", url: bru.getEnvVar("baseUrl") + "/projects", headers: { "Content-Type": "application/json", Authorization: "Bearer " + bru.getVar("token") }, data: { name: "archive-" + Date.now() } });
  bru.setVar("archiveProjectId", project.data.id);
}
tests {
  test("archives a project", function() {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("archiveProjectId"));
    expect(res.body.archived).to.equal(true);
  });
}
