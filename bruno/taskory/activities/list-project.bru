meta {
  name: List by project
  type: http
  seq: 6
}
get {
  url: {{baseUrl}}/activities?project={{projectMarker}}
  body: none
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
headers {
  Accept: application/json
}
docs {
  Spec scenario: activities / Activity listing and filters / Project filter. Expects only activities in Bruno project.
}
script:pre-request {
  const marker = "project-" + Date.now();
  bru.setVar("projectMarker", marker);
  const created = await bru.sendRequest({ method: "POST", url: bru.getEnvVar("baseUrl") + "/activities", headers: { "Content-Type": "application/json", Authorization: "Bearer " + bru.getVar("token") }, data: { date: "2026-11-16", title: marker, project: marker } });
  bru.setVar("projectActivityId", created.data.id);
}
tests {
  test("filters activities by project", function() {
    expect(res.status).to.equal(200);
    expect(res.body.items.map(function(item) { return item.id; })).to.eql([bru.getVar("projectActivityId")]);
  });
}
