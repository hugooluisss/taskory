meta {
  name: Create without title
  type: http
  seq: 15
}
post {
  url: {{baseUrl}}/activities
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
headers {
  Content-Type: application/json
  Accept: application/json
  Accept-Language: es
}
body:json {
  {
    "date": "2026-11-16"
  }
}
docs {
  Spec scenario: activities / Activity creation / Missing required field. Spanish error response; expects 400 VALIDATION_ERROR.
}
tests {
  test("rejects missing title", function() {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("VALIDATION_ERROR");
    expect(res.body.message).to.equal("La solicitud no es válida");
  });
}
