meta {
  name: Get activity
  type: http
  seq: 10
}
get {
  url: {{baseUrl}}/activities/{{independentGetId}}
  body: none
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
headers {
  Accept: application/json
}
docs {
  Spec scenario: activities / Activity read, update and delete / Read activity. Creates its own activity.
}
script:pre-request {
  const created = await bru.sendRequest({ method: "POST", url: bru.getEnvVar("baseUrl") + "/activities", headers: { "Content-Type": "application/json", Authorization: "Bearer " + bru.getVar("token") }, data: { date: "2026-11-16", title: "independent-get-" + Date.now() } });
  bru.setVar("independentGetId", created.data.id);
}
tests {
  test("gets created activity by id", function() {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("independentGetId"));
  });
}
