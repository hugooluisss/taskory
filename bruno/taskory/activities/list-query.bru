meta {
  name: Search activities
  type: http
  seq: 8
}
get {
  url: {{baseUrl}}/activities?q={{searchMarker}}
  body: none
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
headers {
  Accept: application/json
}
docs {
  Spec scenario: activities / Activity listing and filters / Text search. Creates its own marker activity.
}
script:pre-request {
  const marker = "search-" + Date.now();
  bru.setVar("searchMarker", marker);
  const created = await bru.sendRequest({ method: "POST", url: bru.getEnvVar("baseUrl") + "/activities", headers: { "Content-Type": "application/json", Authorization: "Bearer " + bru.getVar("token") }, data: { date: "2026-11-16", title: marker } });
  bru.setVar("searchActivityId", created.data.id);
}
tests {
  test("searches activity title and description", function() {
    expect(res.status).to.equal(200);
    expect(res.body.items.map(function(item) { return item.id; })).to.eql([bru.getVar("searchActivityId")]);
  });
}
