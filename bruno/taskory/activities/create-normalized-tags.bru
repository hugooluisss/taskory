meta {
  name: Create with normalized tags
  type: http
  seq: 3
}
post {
  url: {{baseUrl}}/activities
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
headers {
  Content-Type: application/json
  Accept: application/json
}
body:json {
  {
    "date": "2026-11-14",
    "title": "Bruno tag normalization",
    "tags": ["API", " api ", "Bug"]
  }
}
script:post-response {
  bru.setVar("normalizedActivityId", res.body.id);
}
docs {
  Spec scenario: activities / Tag normalization / Duplicate tags. Run after Create with references and tags; expects tags ["api", "bug"].
}
tests {
  test("trims, lowercases, and deduplicates tags", function() {
    expect(res.status).to.equal(201);
    expect(res.body.tags).to.eql(["api", "bug"]);
  });
}
