meta {
  name: Patch invalid id
  type: http
  seq: 29
}
patch {
  url: {{baseUrl}}/activities/not-a-uuid
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
headers {
  Content-Type: application/json
}
body:json {
  { "title": "Invalid id" }
}
tests {
  test("rejects non UUID patch id", function() {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("VALIDATION_ERROR");
  });
}
