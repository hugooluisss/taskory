meta {
  name: Create with malformed date
  type: http
  seq: 16
}
post {
  url: {{baseUrl}}/activities
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
headers {
  Content-Type: application/json
  Accept: application/json
}
body:json {
  {
    "date": "2026-13-45",
    "title": "Invalid date activity"
  }
}
docs {
  Spec scenario: activities / Activity creation / Missing required field. Malformed date; expects 400 VALIDATION_ERROR.
}
tests {
  test("rejects malformed date", function() {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("VALIDATION_ERROR");
  });
}
