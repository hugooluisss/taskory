meta {
  name: List activities
  type: http
  seq: 4
}
get {
  url: {{baseUrl}}/activities
  body: none
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
headers {
  Accept: application/json
}
docs {
  Spec scenario: activities / Activity listing and filters / Default listing order. Creates and checks its own marker activity.
}
script:pre-request {
  const marker = "list-" + Date.now();
  bru.setVar("listMarker", marker);
  const headers = { "Content-Type": "application/json", Authorization: "Bearer " + bru.getVar("token") };
  const project = await bru.sendRequest({ method: "POST", url: bru.getEnvVar("baseUrl") + "/projects", headers, data: { name: marker } });
  const created = await bru.sendRequest({
    method: "POST",
    url: bru.getEnvVar("baseUrl") + "/activities",
    headers,
    data: { date: "2026-11-16", title: marker, projectIds: [project.data.id] }
  });
  bru.setVar("listActivityId", created.data.id);
}
tests {
  test("lists activities in default order", function() {
    expect(res.status).to.equal(200);
    expect(res.body.items.map(function(item) { return item.id; })).to.include(bru.getVar("listActivityId"));
    expect(res.body).to.have.all.keys("items", "total", "page", "limit");
    expect(res.body.page).to.equal(1);
    expect(res.body.limit).to.equal(50);
  });
}
