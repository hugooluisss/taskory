meta {
  name: Invalid page
  type: http
  seq: 24
}
get {
  url: {{baseUrl}}/activities?page=abc
  body: none
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
headers {
  Accept-Language: en
}
tests {
  test("rejects non-numeric page in English", function() {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("VALIDATION_ERROR");
    expect(res.body.message).to.equal("Request validation failed");
  });
}
