meta {
  name: Zero pagination
  type: http
  seq: 25
}
get {
  url: {{baseUrl}}/activities?page=0&limit=0
  body: none
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
tests {
  test("normalizes zero pagination", function() {
    expect(res.status).to.equal(200);
    expect(res.body.page).to.equal(1);
    expect(res.body.limit).to.equal(50);
  });
}
