meta {
  name: Login
  type: http
  seq: 3
}
post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}
headers {
  Content-Type: application/json
  Accept: application/json
  Accept-Language: en
}
body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}
script:post-response {
    bru.setVar("token", res.body.token);
}
docs {
  Spec scenario: user-auth / User login / Valid credentials; Password security / Profile never exposes secrets. Run after Register; expects 200 {token,user}.
}
tests {
  test("logs in with valid credentials", function() {
    expect(res.status).to.equal(200);
    expect(res.body.token).to.be.a("string");
    expect(res.body.user).to.have.all.keys("id", "email", "name", "language");
  });
}
