meta {
  name: Login invalid credentials
  type: http
  seq: 8
}
post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}
headers {
  Content-Type: application/json
  Accept: application/json
  Accept-Language: fr
}
body:json {
  {
    "email": "missing+{{timestamp}}@example.com",
    "password": "wrong-password"
  }
}
docs {
  Spec scenario: api-errors-i18n / Localized messages / Unsupported language. Also exercises user-auth / User login / Invalid credentials. Unsupported language falls back to English. Repeated login attempts are covered by e2e because a single Bruno request cannot prove the rate limit; password hash storage is covered by database tests because it is not observable over HTTP.
}
tests {
  test("rejects invalid credentials", function() {
    expect(res.status).to.equal(401);
    expect(res.body).to.have.all.keys("statusCode", "code", "message");
    expect(res.body.statusCode).to.equal(401);
    expect(res.body.code).to.equal("INVALID_CREDENTIALS");
    expect(res.body.message).to.equal("Invalid email or password");
  });
}
